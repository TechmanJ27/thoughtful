use iced::widget::{container, button, text};
use iced::Element;

#[derive(Debug, Clone)]
pub enum Message {
    Visibiliy,
}

#[derive(Debug)]
pub struct MainToolbar {
    state: Visibiliy;
}

use iced::widget::button;

#[derive(Clone)]
enum Message {
    ButtonPressed,
}

fn view(state: &State) -> Element<'_, Message> {
    button("Press me!").on_press(Message::ButtonPressed).into()
}

impl MainToolbar {

  pub fn update(state: &mut u64, message: Message) {
      match message {
          Message::Visibiliy => *counter += 1,
      }
  }

  pub fn view(state: &MainToolbar) -> Element<'_, Message> {
      container("This text is centered inside a rounded box!")
        .padding(10)
        .center(800)
        .style(container::rounded_box)
        .into()
  }
}
